# generated by tools/search-test/extract-engine.py, not source
tools/search-test/engine.gen.js

# THE NEWS INGESTION LAYERS. Only two of the three belong in the repository.
#
# news-feed.json      IS committed. It is what the page fetches, so it has to ship.
# news-decisions.json IS committed. It is the persistent editorial layer: every manual
#                     correction, exclusion and pinned Top Development lives there, keyed by
#                     item id, and it is the file that stops the next ingestion run from
#                     silently reverting an editor's decision.
# news-candidates.json is NOT committed. It is the evidence layer, rebuilt in full on every
#                     run and around 160 KB, so committing it would churn the history for
#                     nothing. It stays local for debugging and for writing decisions against.
news-candidates.json

# a working copy of the site that appears in this directory from another process. Not part of
# this work, left untouched, and ignored so that a git add cannot ship it.
_v/

# vendored only for an accessibility run, never served
_axe_tmp.js

# python bytecode from the news build scripts
__pycache__/
*.pyc
